rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwnerUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function ownerCreate(field) {
      return isSignedIn() && request.resource.data[field] == request.auth.uid;
    }
    function ownerExisting(field) {
      return isSignedIn() && resource.data[field] == request.auth.uid;
    }
    function ownsFarmerDoc() {
      return ownerExisting('farmerId')
        || ownerExisting('userId')
        || ownerExisting('user_id');
    }
    function createsFarmerDoc() {
      return ownerCreate('farmerId')
        || ownerCreate('userId')
        || ownerCreate('user_id');
    }

    match /users/{userId} {
      allow read, create, update: if isOwnerUser(userId);
      allow delete: if false;
    }
    match /farms/{farmId} {
      allow create: if createsFarmerDoc();
      allow read, update, delete: if isSignedIn()
        && (farmId == request.auth.uid || ownsFarmerDoc());
    }
    match /trees/{treeId} {
      allow create: if createsFarmerDoc();
      allow read, update, delete: if ownsFarmerDoc();
    }
    match /sensor_readings/{readingId} {
      allow create: if createsFarmerDoc();
      allow read: if ownsFarmerDoc();
      allow update, delete: if false;
    }
    match /weather/{recordId} {
      allow create: if createsFarmerDoc();
      allow read: if ownsFarmerDoc();
      allow update, delete: if false;
    }
    match /irrigation_predictions/{recordId} {
      allow create: if createsFarmerDoc();
      allow read: if ownsFarmerDoc();
      allow update, delete: if false;
    }
    match /fertilizer_predictions/{recordId} {
      allow create: if createsFarmerDoc();
      allow read: if ownsFarmerDoc();
      allow update, delete: if false;
    }
    match /growth_predictions/{recordId} {
      allow create: if createsFarmerDoc();
      allow read: if ownsFarmerDoc();
      allow update, delete: if false;
    }
    match /irrigation_logs/{recordId} {
      allow create: if createsFarmerDoc();
      allow read, update, delete: if ownsFarmerDoc();
    }
    match /fertilizer_logs/{recordId} {
      allow create: if createsFarmerDoc();
      allow read, update, delete: if ownsFarmerDoc();
    }
    match /notifications/{notificationId} {
      allow create: if createsFarmerDoc();
      allow read: if ownsFarmerDoc();
      allow update: if ownsFarmerDoc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if ownsFarmerDoc();
    }
    match /irrigation/{recordId} {
      allow create: if createsFarmerDoc();
      allow read, update, delete: if ownsFarmerDoc();
    }
    match /fertilizer/{recordId} {
      allow create: if createsFarmerDoc();
      allow read, update, delete: if ownsFarmerDoc();
    }
    match /quality_results/{recordId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }
    match /recommendation_rules/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /disease_predictions/{recordId} {
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow list: if isSignedIn();
      allow update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
