rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Structured records belong in Firestore, not Storage.
    // Storage is only for files such as grading or disease images.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
